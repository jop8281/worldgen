{
  "name": "worldgen",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "imports": {
    "#engine": "./src/engine/index.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "worldplay": "bun src/cli/worldplay.ts",
    "worldgen": "bun src/cli/worldgen.ts",
    "eval": "bun src/cli/eval.ts",
    "live": "bun src/cli/live.ts",
    "sandbox": "bun src/cli/sandbox.ts",
    "costs": "bun src/cli/costs.ts",
    "dataset": "bun src/cli/dataset.ts",
    "difficulty": "bun src/cli/difficulty.ts",
    "episode": "bun src/cli/episode.ts",
    "evidence": "bun src/cli/evidence.ts",
    "studio": "bun src/cli/studio.ts",
    "scenario": "bun src/cli/scenario.ts",
    "scorecards": "bun src/cli/scorecards.ts",
    "studio-watch": "bun src/cli/studio-watch.ts",
    "docs": "bun src/cli/worldplay.ts docs",
    "demo:prepare": "bash ../scripts/demo-rehearsal.sh prepare",
    "demo": "bash ../scripts/demo-rehearsal.sh rehearse",
    "qualify": "bash ../scripts/qualify-main.sh",
    "qualify:receipt": "bash ../scripts/qualify-main.sh --validate",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.engine-core.json",
    "test": "bun test --timeout 120000 ./test",
    "check": "bun run typecheck && bun run test",
    "e2e": "bun scripts/e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@boatdev/sdk": "1.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
