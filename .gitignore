.venv/
__pycache__/
*.pyc
node_modules
.env
*.log
worlds/generated/**/transcripts/
.DS_Store
.factory/
.claude/*
!.claude/settings.json
!.claude/hooks/
# The studio run registry (A-329), written into whatever worlds dir the studio serves.
.studio-runs.json
# The studio audit log of POST requests (YOS-187), written into whatever worlds dir the studio serves.
.studio-audit.jsonl
# Studio World Builder uploads (YOS-188): <worlds-dir>/.uploads and <worlds-dir>/<tenant>/.uploads hold operator files.
.uploads/
# Agent Playground episodes (YOS-190): the studio and `bun run episode` write one directory per run here.
eval/episodes/
# Difficulty runs (A-391): `bun run difficulty --out eval/difficulty/<id>` writes the matrix there, which is evidence,
# and every episode's export under episodes/, which stays local.
eval/difficulty/*/episodes/
# A run that did not finish leaves <world>.partial under the worlds dir (A-293, A-359); it is evidence, never a world.
prod/worlds/**/*.partial/
